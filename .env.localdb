# `npm run dev:localdb`: the app against the local Supabase (`npm run db:start`, then `npm run db:reset` for the test data).
# Put the local publishable key from `npx supabase status` in .env.localdb.local (not committed):
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_DATA_MODE=live
VITE_SUPABASE_URL=http://127.0.0.1:54321
